# Server-side secrets — set these in Render's Environment tab in production.
# Locally: copy to .env and run `npm run server` (+ `npm run dev` in another terminal).
# None of these ever reach the browser bundle.

# Groq — powers the terminal avatar chat (required for /api/chat)
GROQ_API_KEY=

# Calendly — desk calendar availability (optional; mock data when unset)
# Personal Access Token: calendly.com → Integrations → API & Webhooks
CALENDLY_TOKEN=

# Hevy — gym week-streak counter (optional; mock data when unset)
# Requires Hevy Pro: https://hevy.com/settings?developer
HEVY_API_KEY=

# Spotify — radio queues your recent top tracks (optional; mock data when unset)
# 1. Create an app at developer.spotify.com with redirect URI
#    http://127.0.0.1:8888/callback  (must be 127.0.0.1 — Spotify rejects "localhost")
# 2. Put the client id + secret below, then run:
#    node --env-file=.env scripts/spotify-auth.mjs
# 3. Paste the printed SPOTIFY_REFRESH_TOKEN here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
